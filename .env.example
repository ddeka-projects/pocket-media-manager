# Existing absolute media directory. App data stays in its .pocket-media-manager folder.
POCKET_MEDIA_MANAGER_MEDIA_ROOT=E:\Hobby Disk
POCKET_MEDIA_MANAGER_HOST=0.0.0.0
POCKET_MEDIA_MANAGER_PORT=8787
# Use the PC's LAN address for VLC on your phone.
POCKET_MEDIA_MANAGER_PUBLIC_BASE_URL=http://192.168.1.50:8787
POCKET_MEDIA_MANAGER_STREAM_FOLDER=_stream
POCKET_MEDIA_MANAGER_SUPPORTED_EXTENSIONS=.mp4,.mkv,.mov,.avi,.webm,.ts
POCKET_MEDIA_MANAGER_MPV_PATH=mpv
